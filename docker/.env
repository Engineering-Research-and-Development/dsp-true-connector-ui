COMPOSE_PROJECT_NAME=trueconnector

#TLS settings
## connector-a
CONNECTOR_A_KEYSTORE_NAME=connector-a.p12
CONNECTOR_A_KEY_PASSWORD=password
CONNECTOR_A_KEYSTORE_PASSWORD=password
CONNECTOR_A_KEYSTORE_ALIAS=connector-a

## connector-b
CONNECTOR_B_KEYSTORE_NAME=connector-b.p12
CONNECTOR_B_KEY_PASSWORD=password
CONNECTOR_B_KEYSTORE_PASSWORD=password
CONNECTOR_B_KEYSTORE_ALIAS=connector-b

#SSL
SSL_ENABLED=false

#TRUSTSTORE
TRUSTSTORE_NAME=dsp-truststore.p12
TRUSTSTORE_PASSWORD=password

#BASE URLS
CONNECTOR_A_BASE_URL=http://connector-a:8080
CONNECTOR_B_BASE_URL=http://connector-b:8080

#UI
CONNECTOR_A_TC_ROOT_API_URL=/connector-a/api/v1
CONNECTOR_B_TC_ROOT_API_URL=/connector-b/api/v1

# UI authentication (Keycloak settings are public browser-client configuration)
CONNECTOR_A_AUTH_PROVIDER=INTERNAL
CONNECTOR_A_KEYCLOAK_URL=http://localhost:8180/
CONNECTOR_A_KEYCLOAK_CLIENT_ID=keycloak-api
CONNECTOR_A_KEYCLOAK_ADMIN_REALM=connector-admin

CONNECTOR_B_AUTH_PROVIDER=INTERNAL
CONNECTOR_B_KEYCLOAK_URL=http://localhost:8180/
CONNECTOR_B_KEYCLOAK_CLIENT_ID=keycloak-api
CONNECTOR_B_KEYCLOAK_ADMIN_REALM=connector-admin